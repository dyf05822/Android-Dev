<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        ✅ 关键修改：添加一个缩放层。
        将所有内容包裹在一个新的 group 中，并将其等比缩小到 60% (scaleX/Y=0.6)。
        这样可以确保图标完整地显示在自适应图标的安全区域内，不会被裁切。
    -->
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:pivotX="12"
        android:pivotY="12">

        <!-- 将图标内容放在一个 group 中，以便对其应用旋转动画 -->
        <group
            android:name="rotationGroup"
            android:pivotX="12"
            android:pivotY="12">
            <!-- 这里是一个简单的气泡图标路径 -->
            <path
                android:fillColor="#FF6200EE"
                android:pathData="M20,2H4C2.9,2 2,2.9 2,4V22L6,18H20C21.1,18 22,17.1 22,16V4C22,2.9 21.1,2 20,2M20,16H5.17L4,17.17V4H20V16Z" />
        </group>

    </group>

</vector>
